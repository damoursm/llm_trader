.env
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
logs/*.log
cache/
# Anchored to the repo root: the DuckDB lives in /data/, but an unanchored
# "data/" ALSO matched src/data/ — which silently hid the entire data-fetcher
# layer from ripgrep/code-search (and any tooling that honors .gitignore).
/data/
.pytest_cache/
*.egg-info/
dist/
build/
.env
# Covers BOTH separators: .env.bak.20260725 and .env.bak-2026-08-31. The old
# ".env.bak.*" required the trailing dot, so a hyphen-dated backup of the live
# .env (real API keys) sat untracked-but-committable.
.env.bak*
.env.backup
logs/
# Coverage artifacts (dev only)
.coverage
coverage.xml
cov*.json
htmlcov/
